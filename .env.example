# Copy this file to `.env` and fill in your key.
# `.env` is git-ignored and is never committed.
#
# The Groq API key is injected as a compile-time `--dart-define` by
# `tool/run.sh`, e.g.  ./tool/run.sh
#
# GROQ_API_KEY is the only required value. The app works without it — the
# post-event feedback analyzer then falls back to the offline heuristic
# evaluator instead of the LLM.

GROQ_API_KEY=API_KEY_HERE

# Optional overrides.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
